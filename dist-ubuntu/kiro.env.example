# Kiro Pro+ API key for headless Ubuntu (no browser login needed).
# Create at: https://app.kiro.dev -> API Keys (Pro/Pro+/Power only).
# The bridge reads this instead of the kiro-cli database.
KIRO_API_KEY=ksk_paste_your_key_here
# Optional: pin region if your account lives elsewhere (default us-east-1).
# KIRO_API_REGION=us-east-1
# Optional: require a password to use YOUR bridge (recommended if port is open).
# KIROCC_API_KEY=make_up_a_long_secret_here
# Hide SKUs the account cannot use (Enterprise-only models Kiro rejects):
# KIROCC_HIDE_MODELS=fable
